<launch>
    <!--
      Full sorting cycle. Bring the cameras up first (multi_camera.launch),
      then the TM driver, then this file.

      The nodes hand off to each other over std_msgs/String feedback topics
      rather than running on a timer, so the order they appear here does not
      matter - each one blocks until the message it waits for arrives.
    -->

    <!-- Where the nodes write captured frames and detection state. -->
    <arg name="runtime_dir" default="$(find tm12_bottle_sorting)/../../runtime"/>

    <!-- Moves the arm to the pose the crate is visible from. -->
    <node name="robot_control" pkg="tm12_bottle_sorting" type="node_1" output="screen"/>

    <!-- Hough-circle bottle detection: waits for "robot has reached", then
         captures RGB-D, finds the bottles and writes the nearest crate slot. -->
    <node name="rgbd_image_saver" pkg="tm12_bottle_sorting" type="bottle_position.py" output="screen">
        <param name="runtime_dir" value="$(arg runtime_dir)"/>
        <param name="camera" value="/cam_1"/>
    </node>

    <!-- Reads that slot and drives the arm to it. -->
    <node name="set_positions_with_feedback" pkg="tm12_bottle_sorting" type="node_3" output="screen">
        <param name="runtime_dir" value="$(arg runtime_dir)"/>
    </node>

    <!-- Close the gripper on the bottle. -->
    <node name="gripper_ON" pkg="tm12_bottle_sorting" type="gripper_ON_node" output="screen"/>

    <!-- Lift clear and present the bottle to the brand camera. -->
    <node name="node_6" pkg="tm12_bottle_sorting" type="node_6" output="screen"/>

    <!-- YOLOv5 brand classification. -->
    <node name="brand_detection" pkg="tm12_bottle_sorting" type="brand_detection.py" output="screen">
        <param name="runtime_dir" value="$(arg runtime_dir)"/>
        <param name="camera" value="/cam_2"/>
    </node>

    <!-- Place into the crate matching the detected brand. -->
    <node name="node_7" pkg="tm12_bottle_sorting" type="node_7" output="screen">
        <param name="runtime_dir" value="$(arg runtime_dir)"/>
    </node>

    <!-- Release. -->
    <node name="node_8" pkg="tm12_bottle_sorting" type="node_8" output="screen"/>

    <!-- Safety overlay: stops the arm while a person is in frame, and
         replans around anything closer than the depth threshold. -->
    <node name="human_detection_node" pkg="tm12_bottle_sorting" type="human_detection_node.py" output="screen">
        <param name="image_topic" value="/cam_1/color/image_raw"/>
    </node>

</launch>
